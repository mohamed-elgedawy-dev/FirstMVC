@using FirstMVC.DAL.Model
@model Department

@{
    ViewData["Title"] = " department  Details";
}

<h1>Details</h1>


<div class="form-group">
    <label asp-for="Name"></label>
    <input asp-for="Name" class="form-control" readonly />

</div>

<div class="form-group">
    <label asp-for="DateOfCreation"></label>
    <input asp-for="DateOfCreation" class="form-control" readonly />

</div>
<div class="form-group">
    <label asp-for="Code"></label>
    <input asp-for="Code" class="form-control" readonly />

</div>
<a asp-action="Edit" class="btn btn-primary" asp-route-id="@Model.Id">Edit</a>

<a asp-action="Index" class="btn btn-primary" asp-route-id="@Model.Id">Back to list</a>

