@using FirstMVC.DAL.Model
@model IEnumerable<Department>
@{
    ViewData["Title"] = "Index";
}

<h1>All Department</h1>




<a asp-controller="Department" asp-action="Create" class="btn btn-danger">Create new Department</a>


<div class="container mt-3">
    <form asp-action="Index" method="get" class="d-flex">
        <input type="text" id="searchQuery" name="searchQuery" class="form-control me-2" placeholder="Search here..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>


<h2 style="text-align: center; font-size: 32px;">Department List</h2>

<table style="width: 80%; margin: 50px auto; border-collapse: collapse; background-image: url('/images/3g388-unsplash.jpg'); background-size: cover; background-position: center center; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);">
    <thead>
        <tr>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">ID</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Name</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Date of Creation</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Code</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var department in Model)
        {
            <tr style="background-color: rgba(0, 0, 0, 0.5);">
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@department.Id</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@department.Name</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@department.DateOfCreation.ToString("yyyy-MM-dd")</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@department.Code</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd;">


                    <partial name="_partialView" model="@department.Id" />


                </td>
            </tr>
        }
    </tbody>
</table>