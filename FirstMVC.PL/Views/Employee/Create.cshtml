@using FirstMVC.DAL.Model
@model EmployeeViewModel
@{
    ViewData["Title"] = "Create";
}






<div style="width: 60%; margin: 50px auto; padding: 20px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.9); box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);">
    <h2 style="text-align: center; margin-bottom: 20px;">Add New Employee</h2>
    
    <form asp-action="Create" method="post">

        <partial name="PartialViews/CreateEditView" />

        <!-- Submit Button -->
        <div style="text-align: center; margin-top: 20px;">
            <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">Save</button>
        </div>
    </form>
    <a asp-action="Index" class="btn btn-danger"> Back to list</a>
</div>
<div asp-validation-summary="All" class="text-danger"></div>

@section Scripts {
    <!-- Validation Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}

