@using FirstMVC.DAL.Model

@model Employee



@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-danger text-white text-center">
            <h3>Are you sure you want to delete this employee?</h3>
        </div>





        <partial name="PartialViews/DeleteDetailsView" />



        <div class="card-footer text-center">
            <form asp-action="Delete" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger btn-lg">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Cancel</a>
            </form>
        </div>
    </div>
</div>

