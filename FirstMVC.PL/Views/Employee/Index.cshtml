@using FirstMVC.DAL.Model
@model IEnumerable<EmployeeViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>All Employee</h1>




<a asp-controller="Employee" asp-action="Create" class="btn btn-danger">Create new Employee</a>


<div class="container mt-3">
    <form asp-action="Index" method="get" class="d-flex">
        <input type="text" id="searchQuery" name="searchQuery" class="form-control me-2" placeholder="Search here..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>


<h2 style="text-align: center; font-size: 32px;">Employee List</h2>

<table style="width: 80%; margin: 50px auto; border-collapse: collapse; background-image: url('files/images/3g388-unsplash.jpg'); background-size: cover; background-position: center center; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);">
    <thead>
        <tr>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Name</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Image</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Age</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Gender</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Employee Type</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Department</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Email</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Phone</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Hiring Date</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Salary</th>
            <th style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white; background-color: rgba(0, 0, 0, 0.7);">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr style="background-color: rgba(0, 0, 0, 0.5);">
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">
                    <img src="~/files/Images/@employee.ImageName" style="max-width: 100%; height: auto; border-radius: 8px;" />
                </td>

                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@employee.Name</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@(employee.Age)</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@employee.Gender</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@employee.EmpType</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">
                    @(employee.Department != null ? employee.Department.Name : "No Department")
                </td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@employee.Email</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@employee.PhoneNumber</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@employee.HiringDate.ToString("yyyy-MM-dd")</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd; color: white;">@employee.Salary.ToString("C")</td>
                <td style="padding: 15px; text-align: center; border: 1px solid #ddd;">
                    <div style="display: block; text-align: center;">


               





                        <a asp-action="Details" asp-controller="Employee" asp-route-id="@employee.Id" style="color: #e8eded; text-decoration: none; padding: 8px 16px; border-radius: 5px; background-color: #34eb3a; display: block; margin: 5px 0;">
                            <i class="fas fa-info-circle"></i> Details
                        </a>
                        <a asp-action="Edit" asp-controller="Employee" asp-route-id="@employee.Id" style="color: #e8eded; text-decoration: none; padding: 8px 16px; border-radius: 5px; background-color: #079af5; display: block; margin: 5px 0;">
                            <i class="fas fa-edit"></i> Update
                        </a>
                        <a asp-action="Delete" asp-controller="Employee" asp-route-id="@employee.Id" style="color: #e8eded; text-decoration: none; padding: 8px 16px; border-radius: 5px; background-color: #a60d1a; display: block; margin: 5px 0;">
                            <i class="fas fa-trash-alt"></i> Delete
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
