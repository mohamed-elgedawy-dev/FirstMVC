<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FirstMVC.PL</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">FirstMVC.PL</a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item" style="margin-right: 10px;">
                            <a class="nav-link" style="
                color: #fff;
                background-color: #007bff; /* أزرق */
                border-radius: 5px;
                padding: 5px 10px;
                text-decoration: none;
                transition: background-color 0.3s ease;
            " onmouseover="this.style.backgroundColor='#0056b3'"
                               onmouseout="this.style.backgroundColor='#007bff'"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item" style="margin-right: 10px;">
                            <a class="nav-link" style="
                color: #fff;
                background-color: #17a2b8; /* فيروزي */
                border-radius: 5px;
                padding: 5px 10px;
                text-decoration: none;
                transition: background-color 0.3s ease;
            " onmouseover="this.style.backgroundColor='#117a8b'"
                               onmouseout="this.style.backgroundColor='#17a2b8'"
                               asp-area="" asp-controller="Home" asp-action="Privacy">
                                Privacy
                            </a>
                        </li>
                        <li class="nav-item" style="margin-right: 10px;">
                            <a class="nav-link" style="
                color: #fff;
                background-color: #28a745; /* أخضر */
                border-radius: 5px;
                padding: 5px 10px;
                text-decoration: none;
                transition: background-color 0.3s ease;
            " onmouseover="this.style.backgroundColor='#218838'"
                               onmouseout="this.style.backgroundColor='#28a745'"
                               asp-area="" asp-controller="Department" asp-action="Index">
                                Department
                            </a>
                        </li>
                        <li class="nav-item" style="margin-right: 10px;">
                            <a class="nav-link" style="
                color: #fff;
                background-color: #ffc107; /* أصفر */
                border-radius: 5px;
                padding: 5px 10px;
                text-decoration: none;
                transition: background-color 0.3s ease;
            " onmouseover="this.style.backgroundColor='#e0a800'"
                               onmouseout="this.style.backgroundColor='#ffc107'"
                               asp-area="" asp-controller="Employee" asp-action="Index">
                                Employee
                            </a>
                        </li>
                    </ul>
                    <!-- زر Log Out -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" style="
                color: #fff;
                background-color: #dc3545; /* أحمر */
                border-radius: 5px;
                padding: 5px 10px;
                text-decoration: none;
                transition: background-color 0.3s ease;
            " onmouseover="this.style.backgroundColor='#c82333'"
                               onmouseout="this.style.backgroundColor='#dc3545'"
                               asp-area="" asp-controller="AccountController" asp-action="LogOut">
                                Log Out
                            </a>
                        </li>
                    </ul>
                </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - FirstMVC.PL - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @RenderSection("ValidationScriptSection", required: false)

</body>
</html>
